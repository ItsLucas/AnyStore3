ANYSTORE_DATABASE_BACKEND=postgres
ANYSTORE_DATABASE_URL=postgres://postgres:anystore@127.0.0.1:54329/anystore
ANYSTORE_BLOB_BACKEND=local_fs
ANYSTORE_LOCAL_BLOB_ROOT=./.anystore-blobs
ANYSTORE_LOCAL_BLOB_SECRET=dev-secret
ANYSTORE_PORT=8088
ANYSTORE_PUBLIC_BASE_URL=http://127.0.0.1:8088
ANYSTORE_MIGRATE_ON_START=true
ANYSTORE_MAINTENANCE_INTERVAL_SECONDS=0
ANYSTORE_LOG=info
