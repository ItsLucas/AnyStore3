            "body": {
              "mode": "raw",
              "raw": "{\n  \"metadata\": {\n    \"set\": {\n      \"version\": 2,\n      \"new_key\": true\n    },\n    \"remove\": []\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const j=pm.response.json();",
                  "const old=Number(pm.collectionVariables.get(\"fileRevision\"));",
                  "pm.expect(j.revision).to.eql(old+1);",
                  "pm.collectionVariables.set(\"oldRevision\",String(old));",
                  "pm.collectionVariables.set(\"fileRevision\",String(j.revision));",
                  "pm.collectionVariables.set(\"patchResponse\",pm.response.text());"
                ]
              }
            }
          ]
