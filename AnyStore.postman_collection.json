            "body": {
              "mode": "raw",
              "raw": "{\n  \"kind\": \"folder\",\n  \"name\": \"postman-folder\",\n  \"parent_id\": \"root\",\n  \"metadata\": {\n    \"suite\": \"postman\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "const j=pm.response.json();",
                  "pm.expect(j.revision).to.eql(1);",
                  "pm.expect(j.kind).to.eql(\"folder\");",
                  "pm.collectionVariables.set(\"folderId\",j.id);",
                  "pm.collectionVariables.set(\"folderRevision\",String(j.revision));",
                  "pm.collectionVariables.set(\"createFolderResponse\",pm.response.text());"
